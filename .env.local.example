# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by create-next-app.

# OpenAI
OPENAI_API_KEY=sk-...

# Supabase (public — safe to expose to the browser)
# Newer projects issue a publishable key (sb_publishable_...), which is the
# drop-in replacement for the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy projects that only show an anon key can use it here instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
