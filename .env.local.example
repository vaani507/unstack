# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by create-next-app.

# OpenAI
# Easiest: run a local model via Ollama (no key, no credits).
#   ollama pull llama3.2
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_PLANNER_MODEL=llama3.2
#   OPENAI_API_KEY=ollama   (any non-empty value works)
# OR, to use the OpenAI cloud API (requires a key + credits on the account):
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   (this is the default)

# Which model to use for planning (cloud default: gpt-4o-mini)
# OPENAI_PLANNER_MODEL=gpt-4o-mini

# Supabase (public — safe to expose to the browser)
# Newer projects issue a publishable key (sb_publishable_...), which is the
# drop-in replacement for the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy projects that only show an anon key can use it here instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
